{
  "name": "math-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "check:learning": "node scripts/verify-learning.cjs",
    "check:rankings": "node scripts/verify-learning-rankings.cjs",
    "check:curriculum": "node scripts/verify-curriculum.cjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:workspace": "node scripts/verify-learning-workspace.cjs",
    "check:daily": "node scripts/verify-daily-learning.cjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "katex": "^0.16.47",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-katex": "^3.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-katex": "^3.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.1"
  }
}
